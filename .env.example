# Theta-mBER weight locations
# Copy to .env and adjust if needed:
#   cp .env.example .env
#   set -a && source .env && set +a

# Preferred: one shared root for all model weights (Theta cluster)
export MBER_WEIGHTS_DIR=/scratch2/mz32/share/mber_weights

# Optional: override individual locations instead of using the shared root
# export MBER_AF_PARAMS_DIR=/scratch2/mz32/share/mber_weights/af_params
# export MBER_NBB2_WEIGHTS_DIR=/scratch2/mz32/share/mber_weights/nbb2_weights
# export MBER_HF_HOME=/scratch2/mz32/share/mber_weights/huggingface
